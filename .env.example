# Server port (default: 3000)
PORT=3000

# Admin password for the control panel (default: robot2026)
ADMIN_PASSWORD=robot2026

# Session secret (auto-generated if not set)
SESSION_SECRET=change-me-to-something-random

# Supabase Credentials (spreadsheet-like database view)
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
